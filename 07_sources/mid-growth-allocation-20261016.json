  "official_facts_F_zh": {
    "7.31": [
      "伐木Q基础伤害60/100/140/180改80/120/160/200，主属性减少改12%，低级冷却变长。",
      "米波成长及部分技能升级改变，不能把旧期构筑评价当跨期常量。"
    ],
    "7.33": [
      "米波忽悠新增自动施放输入；旧魔晶升级移除，挖掘转魔晶、超级米波由神杖提供。",
      "伐木成为全才，神杖改反应装甲屏障，飞锯旧神杖升级移除；25级新增第二飞锯天赋。",
      "露娜光环自他分配改变、月光眩晕缩短。"
    ],
    "7.34": [
      "露娜魔晶改环绕月刃，不再是旧月光升级。",
      "本次仅查看米波成长/天赋、伐木基础伤害/天赋指定条目，未认证所有交互延续。"
    ]
  },
